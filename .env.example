# Copy to .env.local and fill in real values. Never commit .env.local.

# GitHub GraphQL API token (server-only, used to fetch pinned repos on /projects).
# Needs "public_repo" read scope. https://github.com/settings/tokens
GITHUB_TOKEN="YOUR GITHUB TOKEN HERE"
GITHUB_USERNAME="meet96"

# Resend API key (server-only, used by /api/contact to send contact form emails).
# https://resend.com/api-keys
RESEND_API_KEY="YOUR RESEND API KEY HERE"
